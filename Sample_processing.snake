from scripts.common import get_fastp_json

# TODO : remove the need for {ext}, pretty sure it's un-needed and it makes it particularly complicated. 

# deal with mutliple possible extensions : 
wildcard_constraints:
    ext = "(fastq.gz|fq.gz|fastq|fq)",
    prefix = ".+", # this is a trick so that the wildcard don't try to match folders/prefix, this speed up dag resolution as in this case we have too many wildcards, making it less identifyable.
    # unclear why previous negative lookahead does not work anymore
    #    suffix = "^(?!.*_trimmed).*|.{0}",
    suffix = ".*(?<!_trimmed)|.{0}",
    sample = ".+"

rule bwa_index2:
    input: "{file}"
    output: "{file}.sa"
    resources:
        slurm_partition = get_resource("partition"),
        mem_mb = get_resource("mem")
    conda : "%s/bwasamtools.yaml"%CONDA_ENV
    singularity : "docker://quay.io/annacprice/bwasamtools:1.10"
    shell: "bwa index {input}"


rule map_to_mask:
    input: R1 = lambda w:SAMPLE_READS[w.sample][0],
           R2 = lambda w:SAMPLE_READS[w.sample][1],
           index = "%s.sa"%FILTER
    output: bam = temp("{path}/{sample}/Filtered.bam"),
    log: "{path}/{sample}/mapping.log"
    threads: 10
    resources:
        slurm_partition = get_resource("partition"),
        mem_mb = get_resource("mem")
    conda : CONDA_ENV + "/bwasamtools.yaml"
    singularity : "docker://quay.io/annacprice/bwasamtools:1.10"
    shell: """
            bwa mem -t {threads} {FILTER} {input.R1} {input.R2} 2>{log} | samtools view  -b -f 12 -@{threads} - | samtools sort -@{threads} - > {output.bam}
            """


rule bam_to_fastq:
    input: "{path}/{sample}/Filtered.bam"
    output: R1 = temp("{path}/{sample}/Filtered_{prefix}R1{suffix}.{ext}"),
            R2 = temp("{path}/{sample}/Filtered_{prefix}R2{suffix}.{ext}")
    threads: 10
    resources:
        slurm_partition = get_resource("partition"),
        mem_mb = get_resource("mem")
    singularity : "docker://quay.io/annacprice/bedtools:2.29.2"
    shell: """
        bamToFastq -i {input} -fq {output.R1}_temp -fq2 {output.R2}_temp
        if [[ "{wildcards.ext}" == *.gz ]]; then
            gzip -c {output.R1}_temp > {output.R1} && rm {output.R1}_temp
            gzip -c {output.R2}_temp > {output.R2} && rm {output.R2}_temp
        else
            mv {output.R1}_temp {output.R1}
            mv {output.R2}_temp {output.R2}
        fi
        """


if FILTER:
    rule fastp :
        input : file_R1="{path}/{sample}/Filtered_{prefix}R1{suffix}.{ext}",
                file_R2="{path}/{sample}/Filtered_{prefix}R2{suffix}.{ext}"
        output :R1="{path}/{sample}/Filtered_{prefix}R1{suffix}_trimmed.{ext}",
                R2="{path}/{sample}/Filtered_{prefix}R2{suffix}_trimmed.{ext}",
                json="{path}/{sample}/Filtered_{prefix}{suffix}.{ext}_fastp.json",
                html="{path}/{sample}/Filtered_{prefix}{suffix}.{ext}_fastp.html"
        log :   "{path}/{sample}/{prefix}.{suffix}.{ext}.log"
        conda : CONDA_ENV + "/fastp.yaml"
        threads: 8
        resources:
            slurm_partition = get_resource("partition"),
            mem_mb = get_resource("mem")
        singularity : "docker://quay.io/biocontainers/fastp:0.23.4--h5f740d0_0"
        shell : """
        fastp -w {threads} -i {input.file_R1} -I {input.file_R2} -o {output.R1} -O {output.R2} -j {output.json} -h {output.html} > {log} 2>&1
        """
else:
    rule fastp :
        input : file_R1="{path}/{sample}/{prefix}R1{suffix}.{ext}",
                file_R2="{path}/{sample}/{prefix}R2{suffix}.{ext}"
        output :R1="{path}/{sample}/{prefix}R1{suffix}_trimmed.{ext}",
                R2="{path}/{sample}/{prefix}R2{suffix}_trimmed.{ext}",
                json="{path}/{sample}/{prefix}{suffix}.{ext}_fastp.json",
                html="{path}/{sample}/{prefix}{suffix}.{ext}_fastp.html"
        log :   "{path}/{sample}/{prefix}.{suffix}.{ext}.log"
        conda : CONDA_ENV + "/fastp.yaml"
        threads: 8
        resources:
            slurm_partition = get_resource("partition"),
            mem_mb = get_resource("mem")
        singularity : "docker://quay.io/biocontainers/fastp:0.23.4--h5f740d0_0"
        shell :"""
        fastp -w {threads} -i {input.file_R1} -I {input.file_R2} -o {output.R1} -O {output.R2} -j {output.json} -h {output.html} > {log} 2>&1
        """    

rule multiqc :
    input : json=[get_fastp_json(SAMPLE_READS[sample][0], FILTER) for sample in SAMPLES],
    output : expand("{path}/quality_done",path=IN)
    conda : CONDA_ENV + "/multiqc.yaml"
    resources:
        slurm_partition = get_resource("partition"),
        mem_mb = get_resource("mem")
    singularity : "docker://quay.io/annacprice/multiqc:1.9"
    shell : """multiqc --interactive -f {IN}/ -o {IN}/
    touch {output}
    """
